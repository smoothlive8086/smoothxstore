{
  "version": 2,
  "builds": [
    {
      "src": "api/db.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "qr.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/db",
      "dest": "api/db.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
